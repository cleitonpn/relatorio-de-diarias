rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     *  O isolamento entre empreiteiros é garantido AQUI, no servidor.
     *  A tela nunca é a fonte de verdade de permissão.
     * ------------------------------------------------------------------ */

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function existePerfil() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function pertenceA(empresaId) {
      return existePerfil() && perfil().empresaId == empresaId && perfil().ativo == true;
    }

    function ehDono(empresaId) {
      return pertenceA(empresaId) && perfil().papel == 'DONO';
    }

    function empresa(empresaId) {
      return get(/databases/$(database)/documents/empresas/$(empresaId)).data;
    }

    /**
     * Administrador da plataforma (você).
     *
     * A lista de admins NÃO é escrita por ninguém pelo app — só à mão, pelo
     * Console do Firebase. Assim não existe caminho de código que promova
     * alguém a admin, nem por bug nem por invasão de conta.
     */
    function ehAdmin() {
      return autenticado() && (
        // Conta raiz da plataforma. O e-mail vem verificado pelo provedor
        // (Google), e o Firebase não deixa dois usuários com o mesmo e-mail —
        // então ninguém consegue se passar por ela.
        (request.auth.token.email == 'cleitonpnascimento@gmail.com'
          && request.auth.token.email_verified == true)
        // Admins adicionais, criados à mão no Console do Firebase.
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    /**
     * Assinatura vencida NUNCA apaga nem esconde dado: o empreiteiro continua
     * enxergando tudo. O que ela bloqueia é lançar coisa nova.
     */
    function podeEscrever(empresaId) {
      return pertenceA(empresaId)
        && empresa(empresaId).assinatura.status in ['TESTE', 'ATIVA', 'PENDENTE'];
    }

    /* --------------------------- Admin da plataforma --------------------------- */

    match /admins/{uid} {
      // A pessoa consegue descobrir que ela mesma é admin; ninguém escreve daqui.
      allow read: if autenticado() && uid == request.auth.uid;
      allow write: if false;
    }

    /* ------------------------------ Usuários ------------------------------ */

    match /usuarios/{uid} {
      allow read: if ehAdmin() || (autenticado() && (
        uid == request.auth.uid ||
        (existePerfil() && perfil().empresaId == resource.data.empresaId)
      ));

      // Cadastro inicial: a pessoa só cria o próprio perfil, e só como DONO.
      allow create: if autenticado()
        && uid == request.auth.uid
        && request.resource.data.papel == 'DONO'
        && request.resource.data.ativo == true;

      // O dono administra os encarregados da própria empresa.
      allow update: if ehAdmin() || (autenticado() && (
        ehDono(resource.data.empresaId) ||
        (uid == request.auth.uid
          && request.resource.data.papel == resource.data.papel
          && request.resource.data.empresaId == resource.data.empresaId
          && request.resource.data.vePainelFinanceiro == resource.data.vePainelFinanceiro)
      ));

      allow delete: if ehAdmin();
    }

    /* ------------------------------ Empresas ------------------------------ */

    match /empresas/{empresaId} {
      allow read: if ehAdmin() || pertenceA(empresaId);

      allow create: if autenticado()
        && request.resource.data.donoUid == request.auth.uid
        // Ninguém abre conta já assinante: todo mundo começa no teste grátis.
        && request.resource.data.assinatura.status == 'TESTE';

      // O dono nunca mexe na própria assinatura — só o admin (e, no futuro,
      // o webhook do Mercado Pago).
      allow update: if ehAdmin() || (ehDono(empresaId)
        && request.resource.data.assinatura == resource.data.assinatura
        && request.resource.data.donoUid == resource.data.donoUid);

      allow delete: if ehAdmin();

      /* --------------------- Dados operacionais do tenant --------------------- */

      match /colaboradores/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /contratantes/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /feiras/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /stands/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /diarias/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /custos/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /vales/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }

      match /pagamentos/{id} {
        allow read: if ehAdmin() || pertenceA(empresaId);
        allow write: if ehAdmin() || podeEscrever(empresaId);
      }
    }

    // Nada fora do que está declarado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
